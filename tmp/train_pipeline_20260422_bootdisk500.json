            "sh",
            "-ec",
            "program_path=$(mktemp -d)\n\nprintf \"%s\" \"$0\" > \"$program_path/ephemeral_component.py\"\n_KFP_RUNTIME=true python3 -m kfp.dsl.executor_main                         --component_module_path                         \"$program_path/ephemeral_component.py\"                         \"$@\"\n",
            "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef promote_component(\n    artifact_bundle: Input[Artifact],\n    proxy_eval_report: Input[Artifact],\n    gold_eval_report: Input[Artifact],\n    pipeline_eval_report: Input[Artifact],\n    profile: str,\n    registry_report: Output[Artifact],\n    mlflow_tracking_uri_secret: str = \"\",\n):\n    import contextlib\n    import json\n    import os\n    from pathlib import Path\n    from google.cloud import secretmanager\n    from ml import mlflow_tracking\n\n    def resolve_secret_ref(secret_ref: str) -> str:\n        ref = secret_ref.strip()\n        if not ref:\n            return \"\"\n        if not ref.startswith(\"projects/\"):\n            return ref\n        client = secretmanager.SecretManagerServiceClient()\n        response = client.access_secret_version(request={\"name\": ref})\n        return response.payload.data.decode(\"utf-8\")\n\n    @contextlib.contextmanager\n    def apply_env(key: str, value: str):\n        previous = os.environ.get(key)\n        if value:\n            os.environ[key] = value\n        try:\n            yield\n        finally:\n            if previous is None:\n                os.environ.pop(key, None)\n            else:\n                os.environ[key] = previous\n\n    artifact_dir = Path(artifact_bundle.path)\n    artifact_path = artifact_dir / f\"{profile}_ranker.json\"\n    artifact_health_path = artifact_dir / f\"{profile}_artifact_health.json\"\n    with apply_env(\"MLFLOW_TRACKING_URI\", resolve_secret_ref(mlflow_tracking_uri_secret)):\n        registry_payload = mlflow_tracking.register_existing_artifact_bundle(\n            artifact_path=artifact_path,\n            artifact_health_path=artifact_health_path if artifact_health_path.exists() else None,\n            proxy_eval_path=Path(proxy_eval_report.path),\n            gold_eval_path=Path(gold_eval_report.path),\n            pipeline_eval_path=Path(pipeline_eval_report.path),\n        )\n    Path(registry_report.path).write_text(\n        json.dumps(registry_payload, ensure_ascii=True),\n        encoding=\"utf-8\",\n    )\n\n"
          ],
          "image": "europe-west3-docker.pkg.dev/project-22586fae-58b4-4890-aeb/ml/ai-clipping-train:20260422-pipeline-gcloud-7day"
        }
      },
      "exec-train-ranker-component": {
        "container": {
          "args": [
            "--executor_input",
            "{{$}}",
            "--function_to_execute",
            "train_ranker_component"
          ],
          "command": [
            "sh",
            "-c",
            "\nif ! [ -x \"$(command -v pip)\" ]; then\n    python3 -m ensurepip || python3 -m ensurepip --user || apt-get install python3-pip\nfi\n\nPIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-warn-script-location 'kfp==2.16.0' '--no-deps' 'typing-extensions>=3.7.4,<5; python_version<\"3.9\"' && \"$0\" \"$@\"\n",
            "sh",
            "-ec",
            "program_path=$(mktemp -d)\n\nprintf \"%s\" \"$0\" > \"$program_path/ephemeral_component.py\"\n_KFP_RUNTIME=true python3 -m kfp.dsl.executor_main                         --component_module_path                         \"$program_path/ephemeral_component.py\"                         \"$@\"\n",
            "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef train_ranker_component(\n    training_rows: Input[Dataset],\n    profile: str,\n    artifact_bundle: Output[Artifact],\n    training_stats: Output[Artifact],\n    streamer: str = \"\",\n    date_from: str = \"\",\n    date_to: str = \"\",\n    vertex_image_uri: str = \"\",\n    mlflow_tracking_uri_secret: str = \"\",\n):\n    import json\n    import os\n    import shutil\n    import subprocess\n    import tempfile\n    from pathlib import Path\n    from google.cloud import secretmanager\n\n    def resolve_secret_ref(secret_ref: str) -> str:\n        ref = secret_ref.strip()\n        if not ref:\n            return \"\"\n        if not ref.startswith(\"projects/\"):\n            return ref\n        client = secretmanager.SecretManagerServiceClient()\n        response = client.access_secret_version(request={\"name\": ref})\n        return response.payload.data.decode(\"utf-8\")\n\n    env = os.environ.copy()\n    env[\"MLFLOW_REGISTER_ON_TRAIN\"] = \"0\"\n    if streamer.strip():\n        env[\"TRAINING_STREAMER\"] = streamer.strip()\n    if date_from.strip():\n        env[\"DATE_FROM\"] = date_from.strip()\n    if date_to.strip():\n        env[\"DATE_TO\"] = date_to.strip()\n    if vertex_image_uri.strip():\n        env[\"VERTEX_IMAGE_URI\"] = vertex_image_uri.strip()\n    if mlflow_tracking_uri_secret.strip():\n        env[\"MLFLOW_TRACKING_URI\"] = resolve_secret_ref(mlflow_tracking_uri_secret)\n\n    with tempfile.TemporaryDirectory(prefix=\"train-ranker-\") as temp_dir:\n        work_dir = Path(temp_dir)\n        artifact_dir = work_dir / \"artifacts\"\n        artifact_dir.mkdir(parents=True, exist_ok=True)\n        report_path = work_dir / \"training_report.json\"\n        subprocess.run(\n            [\n                \"python\",\n                \"-m\",\n                \"ml.train_ranker\",\n                \"--dataset\",\n                training_rows.path,\n                \"--profile\",\n                profile,\n                \"--artifact-dir\",\n                str(artifact_dir),\n                \"--report-out\",\n                str(report_path),\n            ],\n            check=True,\n            env=env,\n        )\n\n        artifact_path = artifact_dir / f\"{profile}_ranker.json\"\n        artifact = json.loads(artifact_path.read_text(encoding=\"utf-8\"))\n        metrics_payload = {\n            \"selected_model\": artifact.get(\"selected_model\", \"\"),\n            \"validation\": artifact.get(\"validation\", {}),\n            \"training_stats\": artifact.get(\"training_stats\", {}),\n            \"mlflow\": artifact.get(\"mlflow\", {}),\n        }\n\n        bundle_path = Path(artifact_bundle.path)\n        bundle_path.mkdir(parents=True, exist_ok=True)\n        for child in artifact_dir.iterdir():\n            target = bundle_path / child.name\n            if child.is_dir():\n                shutil.copytree(child, target, dirs_exist_ok=True)\n            else:\n                shutil.copy2(child, target)\n        Path(training_stats.path).write_text(\n            json.dumps(metrics_payload, ensure_ascii=True),\n            encoding=\"utf-8\",\n        )\n\n"
