  "deploymentSpec": {
    "executors": {
      "exec-build-eval-dataset-component": {
        "container": {
          "args": [
            "--executor_input",
            "{{$}}",
            "--function_to_execute",
            "build_eval_dataset_component"
          ],
          "command": [
            "sh",
            "-c",
            "\nif ! [ -x \"$(command -v pip)\" ]; then\n    python3 -m ensurepip || python3 -m ensurepip --user || apt-get install python3-pip\nfi\n\nPIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-warn-script-location 'kfp==2.16.0' '--no-deps' 'typing-extensions>=3.7.4,<5; python_version<\"3.9\"' && \"$0\" \"$@\"\n",
            "sh",
            "-ec",
            "program_path=$(mktemp -d)\n\nprintf \"%s\" \"$0\" > \"$program_path/ephemeral_component.py\"\n_KFP_RUNTIME=true python3 -m kfp.dsl.executor_main                         --component_module_path                         \"$program_path/ephemeral_component.py\"                         \"$@\"\n",
            "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef build_eval_dataset_component(\n    training_rows: Input[Dataset],\n    streamer: str,\n    storage_dir: str,\n    proxy_eval_dataset: Output[Dataset],\n    proxy_eval_summary: Output[Artifact],\n    gold_eval_rows: Output[Dataset],\n    gold_eval_dataset: Output[Dataset],\n    gold_eval_summary: Output[Artifact],\n):\n    from ml.pipelines.components import build_eval_dataset_op as component_module\n\n    component_module.run(\n        training_rows_uri=training_rows.path,\n        proxy_eval_dataset_uri=proxy_eval_dataset.path,\n        proxy_eval_summary_uri=proxy_eval_summary.path,\n        gold_eval_rows_uri=gold_eval_rows.path,\n        gold_eval_dataset_uri=gold_eval_dataset.path,\n        gold_eval_summary_uri=gold_eval_summary.path,\n        streamer=streamer,\n        storage_dir=storage_dir,\n    )\n\n"
          ],
          "image": "europe-west3-docker.pkg.dev/project-22586fae-58b4-4890-aeb/ml/ai-clipping-train:20260422-pipeline-gcloud-7day"
        }
      },
      "exec-build-training-dataset-component": {
        "container": {
          "args": [
            "--type",
            "CustomJob",
            "--payload",
            "{\"display_name\": \"{{$.inputs.parameters['display_name']}}\", \"job_spec\": {\"worker_pool_specs\": {{$.inputs.parameters['worker_pool_specs']}}, \"scheduling\": {\"timeout\": \"{{$.inputs.parameters['timeout']}}\", \"restart_job_on_worker_restart\": {{$.inputs.parameters['restart_job_on_worker_restart']}}, \"strategy\": \"{{$.inputs.parameters['strategy']}}\", \"max_wait_duration\": \"{{$.inputs.parameters['max_wait_duration']}}\"}, \"service_account\": \"{{$.inputs.parameters['service_account']}}\", \"tensorboard\": \"{{$.inputs.parameters['tensorboard']}}\", \"enable_web_access\": {{$.inputs.parameters['enable_web_access']}}, \"network\": \"{{$.inputs.parameters['network']}}\", \"reserved_ip_ranges\": {{$.inputs.parameters['reserved_ip_ranges']}}, \"base_output_directory\": {\"output_uri_prefix\": \"{{$.inputs.parameters['base_output_directory']}}\"}, \"persistent_resource_id\": \"{{$.inputs.parameters['persistent_resource_id']}}\", \"psc_interface_config\": {{$.inputs.parameters['psc_interface_config']}}}, \"labels\": {{$.inputs.parameters['labels']}}, \"encryption_spec\": {\"kms_key_name\": \"{{$.inputs.parameters['encryption_spec_key_name']}}\"}}",
            "--project",
            "{{$.inputs.parameters['project']}}",
            "--location",
            "{{$.inputs.parameters['location']}}",
            "--gcp_resources",
            "{{$.outputs.parameters['gcp_resources'].output_file}}"
          ],
          "command": [
            "python3",
            "-u",
            "-m",
            "google_cloud_pipeline_components.container.v1.custom_job.launcher"
          ],
          "image": "gcr.io/ml-pipeline/google-cloud-pipeline-components:2.22.0"
        }
      },
      "exec-collect-twitch-clips-component": {
        "container": {
          "args": [
            "--executor_input",
            "{{$}}",
            "--function_to_execute",
            "collect_twitch_clips_component"
          ],
          "command": [
            "sh",
            "-c",
            "\nif ! [ -x \"$(command -v pip)\" ]; then\n    python3 -m ensurepip || python3 -m ensurepip --user || apt-get install python3-pip\nfi\n\nPIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-warn-script-location 'kfp==2.16.0' '--no-deps' 'typing-extensions>=3.7.4,<5; python_version<\"3.9\"' && \"$0\" \"$@\"\n",
            "sh",
            "-ec",
            "program_path=$(mktemp -d)\n\nprintf \"%s\" \"$0\" > \"$program_path/ephemeral_component.py\"\n_KFP_RUNTIME=true python3 -m kfp.dsl.executor_main                         --component_module_path                         \"$program_path/ephemeral_component.py\"                         \"$@\"\n",
            "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef collect_twitch_clips_component(\n    streamer: str,\n    date_from: str,\n    date_to: str,\n    output_labels: Output[Dataset],\n    twitch_client_id_secret: str = \"\",\n    twitch_client_secret_secret: str = \"\",\n):\n    import os\n    import subprocess\n    from google.cloud import secretmanager\n\n    def resolve_secret_ref(secret_ref: str) -> str:\n        ref = secret_ref.strip()\n        if not ref:\n            return \"\"\n        if not ref.startswith(\"projects/\"):\n            return ref\n        client = secretmanager.SecretManagerServiceClient()\n        response = client.access_secret_version(request={\"name\": ref})\n        return response.payload.data.decode(\"utf-8\")\n\n    env = os.environ.copy()\n    env[\"TWITCH_CLIENT_ID\"] = resolve_secret_ref(twitch_client_id_secret)\n    env[\"TWITCH_CLIENT_SECRET\"] = resolve_secret_ref(twitch_client_secret_secret)\n    subprocess.run(\n        [\n            \"python\",\n            \"-m\",\n            \"ml.collect_twitch_clip_labels\",\n            \"--broadcaster\",\n            streamer,\n            \"--date-from\",\n            date_from,\n            \"--date-to\",\n            date_to,\n            \"--output\",\n            output_labels.path,\n            \"--progress-file\",\n            f\"{output_labels.path}.progress.json\",\n            \"--merge-output\",\n            \"--skip-covered\",\n        ],\n        check=True,\n        env=env,\n    )\n\n"
          ],
          "image": "europe-west3-docker.pkg.dev/project-22586fae-58b4-4890-aeb/ml/ai-clipping-train:20260422-pipeline-gcloud-7day",
          "resources": {
            "cpuLimit": 2.0,
            "resourceCpuLimit": "2"
          }
        }
      },
      "exec-evaluate-ranker-component": {
        "container": {
          "args": [
            "--executor_input",
            "{{$}}",
            "--function_to_execute",
