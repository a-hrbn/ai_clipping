          "worker_pool_specs": {
            "defaultValue": [
              {
                "container_spec": {
                  "args": [
                    "--executor_input",
                    "{{$.json_escape[1]}}",
                    "--function_to_execute",
                    "build_training_dataset_component"
                  ],
                  "command": [
                    "sh",
                    "-c",
                    "\nif ! [ -x \"$(command -v pip)\" ]; then\n    python3 -m ensurepip || python3 -m ensurepip --user || apt-get install python3-pip\nfi\n\nPIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-warn-script-location 'kfp==2.16.0' '--no-deps' 'typing-extensions>=3.7.4,<5; python_version<\"3.9\"' && \"$0\" \"$@\"\n",
                    "sh",
                    "-ec",
                    "program_path=$(mktemp -d)\n\nprintf \"%s\" \"$0\" > \"$program_path/ephemeral_component.py\"\n_KFP_RUNTIME=true python3 -m kfp.dsl.executor_main                         --component_module_path                         \"$program_path/ephemeral_component.py\"                         \"$@\"\n",
                    "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef build_training_dataset_component(\n    labels: Input[Dataset],\n    profile: str,\n    training_rows: Output[Dataset],\n    dataset_llm_provider: str = \"\",\n    groq_api_key_secret: str = \"\",\n    gemini_api_key_secret: str = \"\",\n    ollama_host: str = \"\",\n):\n    import os\n    import subprocess\n    import tempfile\n    from google.cloud import secretmanager\n\n    def resolve_secret_ref(secret_ref: str) -> str:\n        ref = secret_ref.strip()\n        if not ref:\n            return \"\"\n        if not ref.startswith(\"projects/\"):\n            return ref\n        client = secretmanager.SecretManagerServiceClient()\n        response = client.access_secret_version(request={\"name\": ref})\n        return response.payload.data.decode(\"utf-8\")\n\n    env = os.environ.copy()\n    if dataset_llm_provider.strip():\n        env[\"TRAINING_DATASET_LLM_PROVIDER\"] = dataset_llm_provider.strip()\n    if ollama_host.strip():\n        env[\"OLLAMA_HOST\"] = ollama_host.strip()\n    if groq_api_key_secret.strip():\n        env[\"GROQ_API_KEY\"] = resolve_secret_ref(groq_api_key_secret)\n    if gemini_api_key_secret.strip():\n        env[\"GEMINI_API_KEY\"] = resolve_secret_ref(gemini_api_key_secret)\n    with tempfile.TemporaryDirectory(prefix=\"build-training-dataset-\") as temp_dir:\n        subprocess.run(\n            [\n                \"python\",\n                \"-m\",\n                \"ml.build_twitch_training_dataset\",\n                \"--labels\",\n                labels.path,\n                \"--output\",\n                training_rows.path,\n                \"--profile\",\n                profile,\n                \"--work-dir\",\n                os.path.join(temp_dir, \"dataset_work\"),\n            ],\n            check=True,\n            env=env,\n        )\n\n"
                  ],
                  "env": [],
                  "image_uri": "europe-west3-docker.pkg.dev/project-22586fae-58b4-4890-aeb/ml/ai-clipping-train:20260422-pipeline-gcloud-7day"
                },
                "disk_spec": {
                  "boot_disk_size_gb": 500.0,
                  "boot_disk_type": "pd-ssd"
                },
                "machine_spec": {
                  "machine_type": "e2-standard-4"
                },
                "replica_count": 1.0
              }
            ],
            "isOptional": true,
            "parameterType": "LIST"
          }
        }
