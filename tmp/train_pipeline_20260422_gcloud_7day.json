            "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef build_training_dataset_component(\n    labels: Input[Dataset],\n    profile: str,\n    training_rows: Output[Dataset],\n):\n    from ml.pipelines.components import build_training_dataset_op as component_module\n\n    component_module.run(\n        labels_uri=labels.path,\n        output_uri=training_rows.path,\n        profile=profile,\n    )\n\n"
